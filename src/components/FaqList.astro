---
/** Accordion of questions using native <details>: keyboard and screen-reader friendly with no JS. */
import Icon from './Icon.astro';
import type { Lang } from '../i18n/routes';
type L = { en: string; fr: string; ar: string };
interface Props { items: { q: L; a: L }[]; lang: Lang; headingLevel?: 'h3' | 'h4' }
const { items, lang, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((it) => (
    <details class="faq group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4">
        <H class="font-display text-[1.05rem] font-medium">{it.q[lang]}</H>
        <Icon name="chevronDown" class="shrink-0 text-ink-3 transition-transform group-open:rotate-180" />
      </summary>
      <p class="pb-5 text-ink-2">{it.a[lang]}</p>
    </details>
  ))}
</div>
<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
