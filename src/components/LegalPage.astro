---
/** Shared layout for the legal pages. Body sections come from each page. */
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import Icon from './Icon.astro';
import { alternates, langMeta, url, type Lang, type RouteKey } from '../i18n/routes';
import { legal } from '../config';

type L = { en: string; fr: string; ar: string };
interface Props {
  lang: Lang;
  route: RouteKey;
  title: L;
  intro: L;
  sections: { h: L; p: L[] }[];
  updated: string;
}
const { lang, route, title, intro, sections, updated } = Astro.props;
const draft = { en: 'Draft: this text is being finalised and may change. Ask us if anything is unclear.', fr: 'Brouillon : ce texte est en cours de validation et peut changer. Demandez-nous en cas de doute.', ar: 'مسودة: هذا النص قيد المراجعة وقد يتغير. اسألونا إذا كان هناك أي غموض.' };
const upd = { en: 'Last updated', fr: 'Dernière mise à jour', ar: 'آخر تحديث' };
const date = new Intl.DateTimeFormat(langMeta[lang].intl, { dateStyle: 'long' }).format(new Date(updated));
---
<Base lang={lang} title={title[lang]} description={intro[lang]} alternates={alternates(route)}>
  <PageHeader lang={lang} title={title[lang]} intro={intro[lang]} path={url(lang, route)}>
    <p class="mt-3 text-sm text-ink-3">{upd[lang]}: {date}</p>
  </PageHeader>
  <div class="container-page max-w-3xl">
    {legal.draft && <p class="mb-8 flex gap-3 rounded-2xl bg-surface-2 p-4 text-sm"><Icon name="info" class="shrink-0 text-accent-text" />{draft[lang]}</p>}
    <div class="prose-trip space-y-8">
      {sections.map((sec) => (
        <section>
          <h2 class="!mt-0 text-h3">{sec.h[lang]}</h2>
          {sec.p.map((para) => <p class="text-ink-2" set:html={para[lang]} />)}
        </section>
      ))}
    </div>
  </div>
</Base>
