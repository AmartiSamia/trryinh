---
/** Day-by-day timeline: walking/driving time, altitude, night and meals, optional hour-by-hour schedule. */
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { mealLabels, placeLabel, sleepLabels } from '../i18n/catalog';
import type { Lang } from '../i18n/routes';
import type { Trip } from '../lib/trips';

interface Props { trip: Trip; lang: Lang }
const { trip, lang } = Astro.props;
const s = t(lang);
const days = trip.data.itinerary;
const single = days.length === 1;
---
<ol class="itinerary relative">
  {days.map((d, i) => (
    <li class="day relative ps-12 pb-10 last:pb-0">
      <span class="absolute start-0 top-0 grid size-9 place-items-center rounded-full bg-brand font-display text-sm font-semibold text-on-brand ring-4 ring-bg" aria-hidden="true">
        {single ? <Icon name="compass" size={18} /> : i + 1}
      </span>
      {!single && <p class="eyebrow">{s.trip.day.replace('{n}', String(i + 1))}</p>}
      <h3 class="mt-1 text-h3">{d.title[lang]}</h3>
      <p class="mt-2 text-ink-2">{d.text[lang]}</p>

      <dl class="mt-4 flex flex-wrap gap-2 text-sm">
        {d.walk && <div class="fact"><Icon name="walk" size={16} /><dt>{s.trip.walk}</dt><dd dir="ltr">{d.walk}</dd></div>}
        {d.drive && <div class="fact"><Icon name="car" size={16} /><dt>{s.trip.drive}</dt><dd dir="ltr">{d.drive}</dd></div>}
        {d.altitude && <div class="fact"><Icon name="mountain" size={16} /><dt>{s.trip.altitude}</dt><dd dir="ltr">{d.altitude.toLocaleString('en')} m</dd></div>}
        {d.sleep && <div class="fact"><Icon name="bed" size={16} /><dt>{s.trip.sleep}</dt><dd>{sleepLabels[d.sleep.type][lang]}{lang === 'ar' ? '، ' : ', '}{placeLabel(d.sleep.place, lang)}</dd></div>}
        {d.meals.length > 0 && <div class="fact"><Icon name="meal" size={16} /><dt>{s.trip.meals}</dt><dd>{d.meals.map((m) => mealLabels[m][lang]).join(lang === 'ar' ? '، ' : ', ')}</dd></div>}
      </dl>

      {d.schedule && (
        <details class="schedule mt-4 rounded-2xl border border-line" open={days.length <= 3}>
          <summary class="flex min-h-11 cursor-pointer items-center gap-2 px-4 text-sm font-semibold">
            <Icon name="clock" size={16} /> {s.trip.timeline}
          </summary>
          <ul class="space-y-1.5 px-4 pb-4 text-sm">
            {d.schedule.map((it) => (
              <li class="grid grid-cols-[6.5rem_1fr] gap-3">
                <span class="font-semibold tabular-nums text-accent-text" dir="ltr">{it.time}</span>
                <span class="text-ink-2">{it.text[lang]}</span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </li>
  ))}
</ol>

<style>
  /* The vertical line that links the days. */
  .itinerary::before {
    content: '';
    position: absolute;
    inset-inline-start: 1.0625rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--line) 0 6px, transparent 6px 11px);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    background: var(--surface-2);
    padding: 0.35rem 0.75rem;
    color: var(--ink-2);
  }
  .fact dt {
    font-weight: 600;
    color: var(--ink);
  }
  .fact dt::after {
    content: ':';
  }
  .schedule summary::-webkit-details-marker {
    display: none;
  }
  @media print {
    .schedule {
      border: 0;
    }
    .day {
      break-inside: avoid;
    }
  }
</style>
