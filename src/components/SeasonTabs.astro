---
/** Region tabs with best months, temperatures and a packing tip (WAI-ARIA tabs pattern). */
import { getEntry } from 'astro:content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { regions } from '../data/seasons';
import { langMeta, url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const monthFmt = new Intl.DateTimeFormat(langMeta[lang].intl, { month: 'narrow' });
const monthLong = new Intl.DateTimeFormat(langMeta[lang].intl, { month: 'long' });
const months = Array.from({ length: 12 }, (_, i) => ({ n: i + 1, short: monthFmt.format(new Date(2026, i, 15)), long: monthLong.format(new Date(2026, i, 15)) }));
const photos = await Promise.all(regions.map((r) => getEntry('photos', r.photo)));
---
<div class="seasons" data-tabs>
  <div role="tablist" aria-label={s.home.seasonsTitle} class="flex gap-1 overflow-x-auto rounded-full bg-surface-2 p-1">
    {regions.map((r, i) => (
      <button role="tab" id={`tab-${r.key}`} aria-controls={`panel-${r.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
        class="tab min-h-11 flex-1 whitespace-nowrap rounded-full px-4 text-sm font-semibold text-ink-2">
        {s.regions[r.key]}
      </button>
    ))}
  </div>

  {regions.map((r, i) => (
    <div role="tabpanel" id={`panel-${r.key}`} aria-labelledby={`tab-${r.key}`} hidden={i !== 0} tabindex="0"
      class="mt-6 grid gap-6 rounded-3xl md:grid-cols-[1.1fr_1fr] md:items-stretch">
      <Photo photo={photos[i]!} lang={lang} sizes="(min-width: 768px) 600px, 100vw" class="aspect-[4/3] rounded-3xl md:aspect-auto md:min-h-80" />
      <div class="flex flex-col justify-center">
        <h3 class="text-h2">{s.regions[r.key]}</h3>
        <p class="mt-3 text-ink-2">{r.text[lang]}</p>

        <p class="mt-6 text-sm font-semibold">{s.home.bestMonths}</p>
        <ol class="mt-2 grid grid-cols-12 gap-1" dir="ltr">
          {months.map((m) => {
            const good = r.bestMonths.includes(m.n);
            return (
              <li class:list={['grid h-9 place-items-center rounded-md text-xs font-semibold', good ? 'bg-accent text-on-accent' : 'bg-surface-2 text-ink-3']}
                title={m.long}>
                <span aria-hidden="true">{m.short}</span>
                <span class="sr-only">{m.long}{good ? ` ✓` : ''}</span>
              </li>
            );
          })}
        </ol>

        <dl class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-2xl bg-surface p-4 shadow-card">
            <dt class="flex items-center gap-1.5 text-xs font-semibold text-ink-2"><Icon name="sun" size={16} />{s.home.dayTemp}</dt>
            <dd class="mt-1 font-display text-2xl font-semibold" dir="ltr">{r.day} °C</dd>
          </div>
          <div class="rounded-2xl bg-surface p-4 shadow-card">
            <dt class="flex items-center gap-1.5 text-xs font-semibold text-ink-2"><Icon name="moon" size={16} />{s.home.nightTemp}</dt>
            <dd class="mt-1 font-display text-2xl font-semibold" dir="ltr">{r.night} °C</dd>
          </div>
        </dl>
        <p class="mt-4 flex gap-3 rounded-2xl border border-line p-4 text-sm">
          <Icon name="backpack" class="mt-0.5 shrink-0 text-accent-text" />
          <span><strong>{s.home.tip}:</strong> {r.tip[lang]}</span>
        </p>
        <a href={`${url(lang, 'trips')}?${r.query}`} class="link mt-5 inline-flex min-h-11 items-center gap-1.5 font-semibold">
          {s.home.seeTrips} <Icon name="arrow" size={18} flip />
        </a>
      </div>
    </div>
  ))}
</div>

<style>
  .tab[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
</style>

<script>
  // Tabs: click or arrow keys (direction-aware for RTL), Home/End.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
        if (next) select(tabs[(i + next + tabs.length) % tabs.length]);
        else if (e.key === 'Home') select(tabs[0]);
        else if (e.key === 'End') select(tabs[tabs.length - 1]);
        else return;
        e.preventDefault();
      });
    });
  });
</script>
