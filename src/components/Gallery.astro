---
/**
 * Trip photos. Mobile: swipeable scroll-snap row. Desktop: mosaic.
 * Any photo opens a lightbox (<dialog>: focus trap + Escape built in),
 * with arrow keys and swipe. Credits are listed under the gallery.
 */
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
import type { Photo as PhotoEntry } from '../lib/trips';

interface Props { photos: PhotoEntry[]; lang: Lang }
const { photos, lang } = Astro.props;
const s = t(lang);
const n = photos.length;
const large = await Promise.all(
  photos.map(async (p) => {
    const img = await getImage({ src: p.data.file, width: Math.min(1800, p.data.file.width), format: 'webp' });
    return { src: img.src, alt: p.data.alt[lang], credit: `${p.data.author} · ${p.data.licence}` };
  }),
);
---
<section aria-label={s.trip.gallery} class="gallery" data-gallery>
  <!-- Mobile: swipe row -->
  <div class="-mx-4 flex snap-x snap-mandatory gap-2 overflow-x-auto px-4 pb-1 sm:hidden" data-no-print>
    {photos.map((p, i) => (
      <button type="button" data-open={i} class="relative w-[86%] shrink-0 snap-center overflow-hidden rounded-2xl">
        <Photo photo={p} lang={lang} decorative eager={i === 0} sizes="86vw" widths={[400, 640, 800]} class="aspect-[4/3]" />
        <span class="absolute bottom-2 end-2 rounded-full bg-black/60 px-2 py-0.5 text-xs font-semibold text-white" dir="ltr">{i + 1}/{n}</span>
        <span class="sr-only">{p.data.alt[lang]}</span>
      </button>
    ))}
  </div>

  <!-- Desktop: mosaic -->
  <div class="relative hidden gap-2 sm:grid sm:h-[26rem] sm:grid-cols-4 sm:grid-rows-2 lg:h-[30rem]">
    {photos.slice(0, 5).map((p, i) => (
      <button type="button" data-open={i}
        class:list={['group relative overflow-hidden', i === 0 ? 'col-span-2 row-span-2 rounded-s-3xl' : '', i === 2 ? 'rounded-se-3xl' : '', i === 4 || (n < 5 && i === n - 1) ? 'rounded-ee-3xl' : '']}
        aria-label={`${s.trip.photoOf.replace('{i}', String(i + 1)).replace('{n}', String(n))}: ${p.data.alt[lang]}`}>
        <Photo photo={p} lang={lang} decorative eager={i === 0} sizes={i === 0 ? '(min-width: 1248px) 620px, 50vw' : '(min-width: 1248px) 310px, 25vw'} class="size-full" imgClass="transition-transform duration-500 group-hover:scale-105" />
      </button>
    ))}
    {n > 1 && (
      <button type="button" data-open="0" class="btn absolute bottom-4 end-4 bg-surface !min-h-10 text-sm text-ink shadow-card" data-no-print>
        <Icon name="expand" size={18} /> {s.trip.showAll.replace('{n}', String(n))}
      </button>
    )}
  </div>

  <p class="mt-2 text-xs text-ink-3">
    {s.trip.photoCredit}:{' '}
    {photos.map((p, i) => (
      <>
        <a href={p.data.source} target="_blank" rel="noopener" class="hover:underline">{p.data.author}</a>
        {' '}(<a href={p.data.licenceUrl} target="_blank" rel="noopener license" class="hover:underline">{p.data.licence}</a>){i < n - 1 ? ', ' : ''}
      </>
    ))}
    {' '}· {photos[0].data.sourceName}
  </p>

  <dialog class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-[#05070f] p-0 text-white" aria-label={s.trip.gallery} data-lightbox
    data-images={JSON.stringify(large)} data-of={s.trip.photoOf}>
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between p-3">
        <p class="text-sm tabular-nums" aria-live="polite" data-counter></p>
        <button type="button" class="grid size-11 place-items-center rounded-full hover:bg-white/10" data-close aria-label={s.trip.close}><Icon name="close" /></button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2" data-stage>
        <img alt="" class="max-h-full max-w-full select-none object-contain" data-img draggable="false" />
        <button type="button" class="nav absolute start-2 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-black/50 hover:bg-black/70" data-prev aria-label={s.trip.prev}><Icon name="chevron" class="rotate-180 rtl:rotate-0" /></button>
        <button type="button" class="nav absolute end-2 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-black/50 hover:bg-black/70" data-next aria-label={s.trip.next}><Icon name="chevron" class="rtl:rotate-180" /></button>
      </div>
      <div class="p-4 text-center text-sm">
        <p data-caption></p>
        <p class="mt-1 text-xs text-white/70" data-credit></p>
      </div>
    </div>
  </dialog>
</section>

<style>
  .lightbox::backdrop {
    background: #05070f;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dlg = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const imgs: { src: string; alt: string; credit: string }[] = JSON.parse(dlg.dataset.images!);
    const img = dlg.querySelector<HTMLImageElement>('[data-img]')!;
    const counter = dlg.querySelector<HTMLElement>('[data-counter]')!;
    const caption = dlg.querySelector<HTMLElement>('[data-caption]')!;
    const credit = dlg.querySelector<HTMLElement>('[data-credit]')!;
    const rtl = document.documentElement.dir === 'rtl';
    let i = 0;
    let opener: HTMLElement | null = null;

    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      img.src = imgs[i].src;
      img.alt = imgs[i].alt;
      caption.textContent = imgs[i].alt;
      credit.textContent = imgs[i].credit;
      counter.textContent = dlg.dataset.of!.replace('{i}', String(i + 1)).replace('{n}', String(imgs.length));
      // Preload the neighbours for smooth swiping.
      [i + 1, i - 1].forEach((k) => { const p = new Image(); p.src = imgs[(k + imgs.length) % imgs.length].src; });
    };

    root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(Number(b.dataset.open));
        dlg.showModal();
      }),
    );
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('close', () => opener?.focus());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + (rtl ? -1 : 1));
      else if (e.key === 'ArrowLeft') show(i + (rtl ? 1 : -1));
    });

    // Swipe
    let x0: number | null = null;
    const stage = dlg.querySelector<HTMLElement>('[data-stage]')!;
    stage.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) < 40) return;
      show(i + ((dx < 0) !== rtl ? 1 : -1));
    });
  });
</script>
