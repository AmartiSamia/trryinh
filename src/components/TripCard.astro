---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Price from './Price.astro';
import WishButton from './WishButton.astro';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { categoryLabels, cityLabel, difficultyLabels } from '../i18n/catalog';
import { durationBucket, durationLabel, priceFrom, tripPhotos, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  lang: Lang;
  /** Heading level inside the page outline. */
  level?: 'h2' | 'h3';
  sizes?: string;
}
const { trip, lang, level = 'h3', sizes = '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw' } = Astro.props;
const s = t(lang);
const d = trip.data;
const photos = await tripPhotos(trip);
const cover = photos[0];
const href = url(lang, 'trips', trip.id);
const price = priceFrom(trip);
const bookHref = `${url(lang, 'book')}?trip=${trip.id}`;
const groupLabel = d.price.shared && d.price.private ? s.book.options : d.price.private ? s.book.privateOnlyLabel : s.book.sharedOnlyLabel;
const H = level;
const inc = [
  d.includes.meals && { icon: 'meal' as const, label: s.card.meals },
  d.includes.transport && { icon: 'car' as const, label: s.card.transport },
  d.includes.nights && { icon: 'bed' as const, label: s.card.nights },
].filter(Boolean) as { icon: 'meal' | 'car' | 'bed'; label: string }[];
// Data for client-side filters on the trips page.
const search = [d.title.en, d.title.fr, d.title.ar, d.startCity, d.endCity, ...d.mapStops.map((m) => m.name)].join(' ').toLowerCase();
---
<article
  class="trip-card card group relative flex flex-col overflow-hidden"
  data-trip={trip.id}
  data-cat={d.category}
  data-dur={durationBucket(trip)}
  data-diff={d.difficulty}
  data-city={d.startCity}
  data-price={price}
  data-days={d.days}
  data-pop={d.popularity}
  data-private={d.price.private ? '1' : '0'}
  data-search={search}
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Photo photo={cover} lang={lang} sizes={sizes} widths={[400, 640, 800]} class="size-full" imgClass="transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.06]" />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/65 to-transparent" aria-hidden="true"></div>
    <span class="absolute start-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-[#1a1d24] shadow-sm backdrop-blur-sm">
      {categoryLabels[d.category][lang]}
    </span>
    <WishButton slug={trip.id} lang={lang} class="absolute end-2 top-2 z-10" />
    <span class="absolute bottom-3 start-3 inline-flex items-center gap-1.5 rounded-full bg-black/45 px-3 py-1 text-sm font-semibold text-white backdrop-blur-sm">
      <Icon name="clock" size={15} />{durationLabel(trip, lang)}
    </span>
    {photos.length > 1 && (
      <span class="absolute bottom-3 end-3 inline-flex items-center gap-1 rounded-full bg-black/45 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm" aria-hidden="true" dir="ltr">
        <Icon name="camera" size={14} />{photos.length}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="flex flex-wrap items-center gap-x-2 text-xs font-semibold uppercase tracking-wide text-accent-text">
      <span class="inline-flex items-center gap-1"><Icon name="pin" size={14} /><span class="sr-only">{s.card.start}</span>{cityLabel(d.startCity, lang)}</span>
      <span aria-hidden="true" class="text-ink-3">·</span>
      <span><span class="sr-only">{s.card.difficulty}: </span>{difficultyLabels[d.difficulty][lang]}</span>
      {d.maxAltitude && <><span aria-hidden="true" class="text-ink-3">·</span><span dir="ltr">{d.maxAltitude.toLocaleString('en')} m</span></>}
    </p>
    <H class="mt-2 text-h3 font-display">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{d.title[lang]}</a>
    </H>
    <p class="mt-2 line-clamp-2 text-sm text-ink-2">{d.summary[lang]}</p>
    <ul class="mt-3 flex flex-wrap gap-1.5 text-xs font-medium">
      {inc.length > 0 && <li class="sr-only">{s.card.included}:</li>}
      {inc.map((i) => (
        <li class="chip-ok inline-flex items-center gap-1 rounded-full px-2.5 py-1"><Icon name={i.icon} size={14} />{i.label}</li>
      ))}
      <li class="inline-flex items-center gap-1 rounded-full bg-surface-2 px-2.5 py-1 text-ink-2"><Icon name="users" size={14} />{groupLabel}</li>
    </ul>
    <div class="mt-auto pt-5">
      <div class="border-t border-line pt-4">
        <p class="leading-tight">
          <span class="text-xs text-ink-3">{s.common.from} </span>
          <Price mad={price} lang={lang} class="font-display text-2xl font-semibold" />
          <span class="whitespace-nowrap text-xs text-ink-3"> {s.common.perPerson}</span>
        </p>
        <div class="mt-3 flex items-center justify-between gap-3">
          <p class="inline-flex min-w-0 items-center gap-1 text-xs font-medium text-success"><Icon name="check" size={14} class="shrink-0" />{s.more.trust[0].title}</p>
          <a href={bookHref} class="btn btn-accent relative z-10 !min-h-11 shrink-0 !px-4 text-sm" aria-label={`${s.book.cta}: ${d.title[lang]}`}>{s.book.cta}</a>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .trip-card {
    transition: transform 0.35s var(--ease-out-soft), box-shadow 0.35s;
  }
  .trip-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.35);
  }
  .trip-card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .chip-ok {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 12%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .trip-card,
    .trip-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>
