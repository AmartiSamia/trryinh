---
/** "Signature trips": a swipeable row of large photo cards with arrows (scroll-snap, RTL-aware). */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Price from './Price.astro';
import WishButton from './WishButton.astro';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { categoryLabels, difficultyLabels } from '../i18n/catalog';
import { durationLabel, priceFrom, tripPhotos, type Trip } from '../lib/trips';

interface Props { lang: Lang; trips: Trip[] }
const { lang, trips } = Astro.props;
const s = t(lang);
const m = s.more;
const cards = await Promise.all(trips.map(async (tr) => ({ tr, cover: (await tripPhotos(tr))[0] })));
---
<section class="signature py-20" aria-labelledby="sig-title">
  <div class="container-page">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="eyebrow">{m.signatureEyebrow}</p>
        <h2 id="sig-title" class="mt-2 text-h2">{m.signatureTitle}</h2>
        <p class="mt-3 text-ink-2">{m.signatureText}</p>
      </div>
      <div class="flex gap-2" data-no-print>
        <button type="button" class="arrow" data-sig-prev aria-label={m.prev}><Icon name="arrow" class="rotate-180 rtl:rotate-0" /></button>
        <button type="button" class="arrow" data-sig-next aria-label={m.next}><Icon name="arrow" flip /></button>
      </div>
    </div>
  </div>

  <ul class="track mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4" data-sig-track>
    {cards.map(({ tr, cover }, i) => (
      <li class="sig-card group relative shrink-0 snap-start overflow-hidden rounded-[1.75rem] text-white" data-sig-item>
        <Photo photo={cover} lang={lang} decorative sizes="(min-width: 1024px) 420px, 80vw" widths={[480, 720, 960]} class="!absolute inset-0" imgClass="transition-transform duration-700 group-hover:scale-105" />
        <span class="absolute inset-0" style="background:linear-gradient(180deg,rgb(0 0 0/.25) 0%,transparent 30%,rgb(8 9 12/.92) 100%)"></span>
        {i === 0 && <span class="absolute start-4 top-4 rounded-full bg-accent px-3 py-1 text-xs font-bold text-on-accent">★ {m.signatureEyebrow}</span>}
        {i !== 0 && <span class="absolute start-4 top-4 rounded-full bg-black/55 px-3 py-1 text-xs font-semibold backdrop-blur-sm">{categoryLabels[tr.data.category][lang]}</span>}
        <WishButton slug={tr.id} lang={lang} class="absolute end-3 top-3 z-10" />
        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
          <p class="text-sm text-white/80">{durationLabel(tr, lang)} · {difficultyLabels[tr.data.difficulty][lang]}{tr.data.maxAltitude && <span dir="ltr"> · {tr.data.maxAltitude.toLocaleString('en')} m</span>}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold leading-tight">
            <a href={url(lang, 'trips', tr.id)} class="after:absolute after:inset-0">{tr.data.title[lang]}</a>
          </h3>
          <p class="mt-2 line-clamp-2 text-sm text-white/85">{tr.data.summary[lang]}</p>
          <div class="mt-4 flex items-center justify-between gap-3">
            <p class="leading-tight"><span class="text-xs text-white/75">{s.common.from} </span><Price mad={priceFrom(tr)} lang={lang} class="font-display text-xl font-semibold" /></p>
            <a href={`${url(lang, 'book')}?trip=${tr.id}`} class="btn btn-accent relative z-10 !min-h-11 !px-5 text-sm" aria-label={`${s.book.cta}: ${tr.data.title[lang]}`}>{s.book.cta}</a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .track {
    /* Align the first card with the page content, let the row bleed to the edge. */
    padding-inline: max(1rem, calc((100vw - 78rem) / 2 + 1.5rem));
    scroll-padding-inline: max(1rem, calc((100vw - 78rem) / 2 + 1.5rem));
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .sig-card {
    width: min(82vw, 25rem);
    aspect-ratio: 4 / 5;
  }
  .sig-card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: background-color 0.2s, opacity 0.2s;
  }
  .arrow:hover {
    background: var(--surface-2);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.signature').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('[data-sig-track]')!;
    const prev = sec.querySelector<HTMLButtonElement>('[data-sig-prev]')!;
    const next = sec.querySelector<HTMLButtonElement>('[data-sig-next]')!;
    const rtl = document.documentElement.dir === 'rtl';
    const step = () => (track.querySelector<HTMLElement>('[data-sig-item]')?.offsetWidth ?? 300) + 20;
    // In RTL, scrollLeft goes negative; normalise to "distance from start".
    const pos = () => Math.abs(track.scrollLeft);
    const update = () => {
      prev.disabled = pos() < 8;
      next.disabled = pos() + track.clientWidth >= track.scrollWidth - 8;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: (rtl ? 1 : -1) * step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: (rtl ? -1 : 1) * step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
