---
/** Amazigh lozenge with a mountain path inside. Uses currentColor + the accent token. */
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M16 1.8 30.2 16 16 30.2 1.8 16Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
  <path d="M7.2 18.6 12 13.4l3.4 3.4 4.2-5.4 5.2 7.2" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="16" cy="23.4" r="1.6" fill="currentColor" />
</svg>
