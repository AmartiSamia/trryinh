---
/**
 * Hiking to Atlas mark (from the agency logo, built by scripts/build-logo.mjs).
 * The black parts are a CSS mask painted in currentColor, so the mark works on
 * light, dark and photo backgrounds; the red swoosh keeps its colour.
 * `size` is the height in px.
 */
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
const w = Math.round((size * 380) / 170);
---
<span class:list={['hta-mark', cls]} style={`height:var(--mark-h, ${size}px)`} aria-hidden="true">
  <img src="/brand/hta-color.png" alt="" width={w} height={size} decoding="async" />
</span>

<style>
  .hta-mark {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    aspect-ratio: 380 / 170;
  }
  .hta-mark::before {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    -webkit-mask: url('/brand/hta-mask.png') center / contain no-repeat;
    mask: url('/brand/hta-mask.png') center / contain no-repeat;
  }
  .hta-mark img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
