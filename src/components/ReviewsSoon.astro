---
/** Honest empty state until real reviews exist. No fake stars or counters. */
import Icon from './Icon.astro';
import { social, contact } from '../config';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const links = [
  social.googleBusiness && { href: social.googleBusiness, label: 'Google' },
  social.tripadvisor && { href: social.tripadvisor, label: 'TripAdvisor' },
].filter(Boolean) as { href: string; label: string }[];
// Until the Google/TripAdvisor pages exist, reviews can be sent by email.
const reviewHref = social.googleBusiness || `mailto:${contact.email}?subject=Review`;
---
<div class="card flex flex-col items-start gap-5 p-6 sm:p-8 md:flex-row md:items-center">
  <div class="grid size-14 shrink-0 place-items-center rounded-2xl bg-surface-2 text-accent-text">
    <Icon name="star" size={28} />
  </div>
  <div class="flex-1">
    <h3 class="text-h3">{s.home.reviewsSoon}</h3>
    <p class="mt-2 max-w-2xl text-ink-2">{s.home.reviewsSoonText}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {links.map((l) => <a href={l.href} target="_blank" rel="noopener" class="btn btn-ghost">{l.label}</a>)}
    <a href={reviewHref} class="btn btn-brand" target={social.googleBusiness ? '_blank' : undefined} rel="noopener">{s.home.leaveReview}</a>
  </div>
</div>
