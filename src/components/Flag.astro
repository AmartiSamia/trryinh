---
/**
 * Small inline SVG flags for the language menu (decorative: the language name
 * is always written next to it). No emoji: Windows does not render flag emoji.
 */
type Code = 'gb' | 'fr' | 'es' | 'de' | 'pt' | 'ma';
interface Props { code: Code; class?: string; size?: number }
const { code, class: cls, size = 20 } = Astro.props;
const h = Math.round((size * 2) / 3);
// Moroccan pentagram (outline), centred in a 30 × 20 box.
const star = [0, 2, 4, 1, 3]
  .map((k) => {
    const a = ((-90 + k * 72) * Math.PI) / 180;
    return `${(15 + 5.2 * Math.cos(a)).toFixed(2)},${(10.6 + 5.2 * Math.sin(a)).toFixed(2)}`;
  })
  .join(' ');
---
<svg class:list={['flag', cls]} width={size} height={h} viewBox={code === 'gb' ? '0 0 60 30' : '0 0 30 20'}
  preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {code === 'gb' && (
    <>
      <rect width="60" height="30" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </>
  )}
  {code === 'fr' && (
    <>
      <rect width="10" height="20" fill="#0055A4" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#EF4135" />
    </>
  )}
  {code === 'es' && (
    <>
      <rect width="30" height="20" fill="#AA151B" />
      <rect y="5" width="30" height="10" fill="#F1BF00" />
    </>
  )}
  {code === 'de' && (
    <>
      <rect width="30" height="6.67" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#DD0000" />
      <rect y="13.33" width="30" height="6.67" fill="#FFCE00" />
    </>
  )}
  {code === 'pt' && (
    <>
      <rect width="12" height="20" fill="#046A38" />
      <rect x="12" width="18" height="20" fill="#DA291C" />
      <circle cx="12" cy="10" r="4" fill="#FFE900" stroke="#046A38" stroke-width="0.6" />
    </>
  )}
  {code === 'ma' && (
    <>
      <rect width="30" height="20" fill="#C1272D" />
      <polygon points={star} fill="none" stroke="#006233" stroke-width="1.1" stroke-linejoin="round" />
    </>
  )}
</svg>

<style>
  .flag {
    flex-shrink: 0;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
</style>
