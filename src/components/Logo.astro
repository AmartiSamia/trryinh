---
import LogoMark from './LogoMark.astro';
interface Props { class?: string; size?: number }
const { class: cls, size = 34 } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2', cls]} dir="ltr">
  <LogoMark size={size} />
  <span class="font-display text-[0.92rem] font-bold uppercase leading-[1.02] tracking-[0.08em] max-[359px]:sr-only">Hiking<br />to Atlas</span>
</span>
