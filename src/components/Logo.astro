---
import LogoMark from './LogoMark.astro';
interface Props { class?: string; size?: number }
const { class: cls, size = 30 } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', cls]} dir="ltr">
  <LogoMark size={size} />
  <span class="font-display text-[1.375rem] font-semibold leading-none tracking-[-0.02em] max-[359px]:sr-only">iberdan</span>
</span>
