---
/**
 * Terms (template).
 * TODO(youssef): have these checked; add payment method, deposit and agency registration.
 * TODO(review-ar/es/de/pt): native review.
 */
import LegalPage from '../components/LegalPage.astro';
import type { Lang, Text } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tbc: Text = { en: '<strong>[to be confirmed]</strong>', fr: '<strong>[à confirmer]</strong>', es: '<strong>[por confirmar]</strong>', de: '<strong>[wird bestätigt]</strong>', pt: '<strong>[a confirmar]</strong>', ar: '<strong>[سيتم تأكيده]</strong>' };
const sections = [
  {
    h: { en: 'Requests and confirmation', fr: 'Demandes et confirmation', es: 'Solicitudes y confirmación', de: 'Anfragen und Bestätigung', pt: 'Pedidos e confirmação', ar: 'الطلبات والتأكيد' },
    p: [{
      en: 'A request sent from this website (WhatsApp or email) is not a booking. Your trip is booked once we have confirmed availability and the final price in writing, and you have accepted them.',
      fr: 'Une demande envoyée depuis ce site (WhatsApp ou e-mail) n’est pas une réservation. Votre voyage est réservé lorsque nous avons confirmé par écrit la disponibilité et le prix final, et que vous les avez acceptés.',
      es: 'Una solicitud enviada desde esta web (WhatsApp o correo) no es una reserva. Su viaje queda reservado cuando hemos confirmado por escrito la disponibilidad y el precio final y usted los ha aceptado.',
      de: 'Eine Anfrage über diese Website (WhatsApp oder E-Mail) ist keine Buchung. Ihre Reise ist gebucht, sobald wir Verfügbarkeit und Endpreis schriftlich bestätigt und Sie beides angenommen haben.',
      pt: 'Um pedido enviado a partir deste site (WhatsApp ou e-mail) não é uma reserva. A viagem fica reservada quando confirmarmos por escrito a disponibilidade e o preço final e os tiver aceitado.',
      ar: 'الطلب المرسل من هذا الموقع (واتساب أو البريد الإلكتروني) ليس حجزا. تُحجز رحلتكم عندما نؤكد كتابةً التوفر والسعر النهائي وتوافقون عليهما.',
    }],
  },
  {
    h: { en: 'Prices and payment', fr: 'Prix et paiement', es: 'Precios y pago', de: 'Preise und Zahlung', pt: 'Preços e pagamento', ar: 'الأسعار والدفع' },
    p: [
      {
        en: 'Prices on the website are per person and indicative. The price that counts is the one confirmed in writing. Currency conversions are approximate.',
        fr: 'Les prix affichés sont par personne et indicatifs. Le prix qui fait foi est celui confirmé par écrit. Les conversions de devises sont approximatives.',
        es: 'Los precios de la web son por persona y orientativos. El precio válido es el confirmado por escrito. Las conversiones de moneda son aproximadas.',
        de: 'Die Preise auf der Website gelten pro Person und sind Richtwerte. Maßgeblich ist der schriftlich bestätigte Preis. Währungsumrechnungen sind ungefähr.',
        pt: 'Os preços no site são por pessoa e indicativos. O preço que conta é o confirmado por escrito. As conversões de moeda são aproximadas.',
        ar: 'الأسعار المعروضة للشخص وتقريبية. السعر المعتمد هو المؤكد كتابةً. تحويل العملات تقريبي.',
      },
      {
        en: `Payment method and deposit: ${tbc.en}. No payment is taken on this website.`,
        fr: `Mode de paiement et acompte : ${tbc.fr}. Aucun paiement n’est encaissé sur ce site.`,
        es: `Forma de pago y anticipo: ${tbc.es}. En esta web no se cobra ningún pago.`,
        de: `Zahlungsweise und Anzahlung: ${tbc.de}. Auf dieser Website wird keine Zahlung entgegengenommen.`,
        pt: `Forma de pagamento e sinal: ${tbc.pt}. Neste site não é cobrado nenhum pagamento.`,
        ar: `طريقة الدفع والعربون: ${tbc.ar}. لا يتم أي دفع على هذا الموقع.`,
      },
    ],
  },
  {
    h: { en: 'Your health, fitness and insurance', fr: 'Santé, condition physique et assurance', es: 'Salud, forma física y seguro', de: 'Gesundheit, Kondition und Versicherung', pt: 'Saúde, forma física e seguro', ar: 'الصحة واللياقة والتأمين' },
    p: [{
      en: 'Tell us about any health issue that matters for the trip. Mountain treks need the fitness described on each trip page. We strongly recommend travel insurance covering trekking and medical evacuation.',
      fr: 'Signalez-nous tout problème de santé important pour le voyage. Les treks demandent la condition physique décrite sur chaque page. Nous recommandons vivement une assurance couvrant le trek et l’évacuation médicale.',
      es: 'Infórmenos de cualquier problema de salud relevante para el viaje. Los treks de montaña requieren la forma física descrita en cada página. Recomendamos encarecidamente un seguro que cubra el trekking y la evacuación médica.',
      de: 'Teilen Sie uns gesundheitliche Punkte mit, die für die Reise wichtig sind. Bergtreks erfordern die auf jeder Reiseseite beschriebene Kondition. Wir empfehlen dringend eine Reiseversicherung mit Trekking und medizinischer Evakuierung.',
      pt: 'Informe-nos de qualquer problema de saúde relevante para a viagem. Os trekkings de montanha exigem a forma física descrita em cada página. Recomendamos vivamente um seguro que cubra trekking e evacuação médica.',
      ar: 'أخبرونا بأي مشكلة صحية تهم الرحلة. تتطلب رحلات الجبل اللياقة الموضحة في صفحة كل رحلة. ننصح بشدة بتأمين سفر يغطي المشي والإجلاء الطبي.',
    }],
  },
  {
    h: { en: 'Safety and changes', fr: 'Sécurité et modifications', es: 'Seguridad y cambios', de: 'Sicherheit und Änderungen', pt: 'Segurança e alterações', ar: 'السلامة والتغييرات' },
    p: [{
      en: 'In the mountains, the guide makes the safety decisions, including changing the route or turning back. Weather, road or other conditions outside our control may change a programme; we always look for the best alternative with you.',
      fr: 'En montagne, le guide prend les décisions de sécurité, y compris changer d’itinéraire ou faire demi-tour. La météo, l’état des routes ou d’autres conditions indépendantes de notre volonté peuvent modifier un programme ; nous cherchons toujours avec vous la meilleure alternative.',
      es: 'En la montaña, el guía toma las decisiones de seguridad, incluido cambiar de ruta o dar la vuelta. El tiempo, las carreteras u otras circunstancias ajenas a nosotros pueden cambiar un programa; siempre buscamos con usted la mejor alternativa.',
      de: 'In den Bergen trifft der Guide die Sicherheitsentscheidungen, auch über Routenänderungen oder Umkehr. Wetter, Straßenzustand oder andere Umstände außerhalb unserer Kontrolle können ein Programm ändern; wir suchen immer gemeinsam mit Ihnen die beste Alternative.',
      pt: 'Na montanha, o guia toma as decisões de segurança, incluindo mudar de percurso ou voltar para trás. O tempo, as estradas ou outras condições fora do nosso controlo podem alterar um programa; procuramos sempre consigo a melhor alternativa.',
      ar: 'في الجبل يتخذ المرشد قرارات السلامة، بما في ذلك تغيير المسار أو العودة. قد يتغير البرنامج بسبب الطقس أو حالة الطرق أو ظروف أخرى خارجة عن إرادتنا، ونبحث دائما معكم عن أفضل بديل.',
    }],
  },
  {
    h: { en: 'Applicable law', fr: 'Droit applicable', es: 'Ley aplicable', de: 'Anwendbares Recht', pt: 'Lei aplicável', ar: 'القانون المطبق' },
    p: [{
      en: `These terms are governed by Moroccan law. Agency registration: ${tbc.en}.`,
      fr: `Ces conditions sont régies par le droit marocain. Immatriculation de l’agence : ${tbc.fr}.`,
      es: `Estas condiciones se rigen por la ley marroquí. Registro de la agencia: ${tbc.es}.`,
      de: `Diese Bedingungen unterliegen marokkanischem Recht. Registrierung der Agentur: ${tbc.de}.`,
      pt: `Estes termos regem-se pela lei marroquina. Registo da agência: ${tbc.pt}.`,
      ar: `تخضع هذه الشروط للقانون المغربي. تسجيل الوكالة: ${tbc.ar}.`,
    }],
  },
];
---
<LegalPage lang={lang} route="terms" updated="2026-11-08" sections={sections}
  title={{ en: 'Terms and conditions', fr: 'Conditions générales', es: 'Condiciones generales', de: 'Allgemeine Geschäftsbedingungen', pt: 'Termos e condições', ar: 'الشروط العامة' }}
  intro={{ en: 'The simple rules of how we work together.', fr: 'Les règles simples de notre collaboration.', es: 'Las reglas sencillas de cómo trabajamos juntos.', de: 'Die einfachen Regeln unserer Zusammenarbeit.', pt: 'As regras simples de como trabalhamos juntos.', ar: 'القواعد البسيطة لتعاملنا معا.' }} />
