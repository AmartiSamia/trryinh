---
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Photo from '../components/Photo.astro';
import TripCard from '../components/TripCard.astro';
import Icon from '../components/Icon.astro';
import { alternates, langMeta, url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site } from '../config';

interface Props { lang: Lang; article: CollectionEntry<'guide'> }
const { lang, article } = Astro.props;
const s = t(lang);
const a = article.data;
const { Content } = await render(article);
const photo = (await getEntry(a.photo))!;
const related = await getEntries(a.relatedTrips);
const og = await getImage({ src: photo.data.file, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const date = new Intl.DateTimeFormat(langMeta[lang].intl, { dateStyle: 'long' }).format(a.date);
const draft = { en: 'Draft: this article is waiting for a final review.', fr: 'Brouillon : cet article attend une dernière relecture.', ar: 'مسودة: هذا المقال في انتظار المراجعة النهائية.' }[lang];
const relatedTitle = { en: 'Trips for this', fr: 'Les voyages associés', ar: 'رحلات ذات صلة' }[lang];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.description,
  datePublished: a.date.toISOString(), inLanguage: lang, image: new URL(og.src, site.url).href,
  author: { '@type': 'Organization', name: site.name }, publisher: { '@id': `${site.url}/#agency` },
};
---
<Base lang={lang} title={a.title} description={a.description} alternates={alternates('guide', a.key)} ogImage={og.src} ogType="article" jsonLd={jsonLd} noindex={!a.reviewed}>
  <article class="container-page max-w-3xl pt-8">
    <Breadcrumb lang={lang} items={[{ name: 'Iberdan', path: url(lang, 'home') }, { name: s.nav.guide, path: url(lang, 'guide') }, { name: a.title, path: url(lang, 'guide', a.key) }]} />
    <h1 class="mt-4 text-h1">{a.title}</h1>
    <p class="mt-4 text-lg text-ink-2">{a.description}</p>
    <p class="mt-3 text-sm text-ink-3">{site.name} · {date}</p>
    {!a.reviewed && <p class="mt-6 flex gap-3 rounded-2xl bg-surface-2 p-4 text-sm"><Icon name="info" class="shrink-0 text-accent-text" />{draft}</p>}
    <Photo photo={photo} lang={lang} eager sizes="(min-width: 800px) 768px, 100vw" class="mt-8 aspect-[16/9] rounded-3xl" />
    <p class="mt-2 text-xs text-ink-3">{photo.data.author} · {photo.data.licence} · {photo.data.sourceName}</p>
    <div class="prose-trip article mt-8 text-[1.0625rem] leading-relaxed text-ink-2"><Content /></div>
  </article>
  {related.length > 0 && (
    <section class="container-page mt-16" aria-labelledby="rel">
      <h2 id="rel" class="text-h2">{relatedTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{related.map((tr) => <TripCard trip={tr} lang={lang} />)}</div>
    </section>
  )}
</Base>

<style>
  .article :global(h2) {
    color: var(--ink);
    font-size: var(--text-h2);
  }
  .article :global(strong) {
    color: var(--ink);
  }
  .article :global(li) {
    margin-block: 0.35em;
  }
  .article :global(table) {
    display: block;
    overflow-x: auto;
    margin-block: 1.5em;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .article :global(th),
  .article :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0.9rem;
    text-align: start;
    white-space: nowrap;
  }
  .article :global(th) {
    color: var(--ink);
  }
</style>
