---
import Callback from '../components/Callback.astro';
/** Contact: WhatsApp first, then phone and email, map of Imlil and opening hours. */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RouteMap from '../components/RouteMap.astro';
import Icon from '../components/Icon.astro';
import { alternates, url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { contact, social } from '../config';
import { waLink } from '../lib/whatsapp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const L = <T,>(o: Record<Lang, T>) => o[lang];
const c = L({
  en: { title: 'Contact', intro: 'The fastest way is WhatsApp. We answer every day, usually within a few hours.', where: 'Where we are', hours: 'Opening hours', hoursText: 'Open 24/7, every day of the year', note: 'Write at any time. Morocco time (GMT+1).', mapLabel: 'Map of Imlil' },
  fr: { title: 'Contact', intro: 'Le plus rapide, c’est WhatsApp. Nous répondons tous les jours, en général en quelques heures.', where: 'Où nous trouver', hours: 'Horaires', hoursText: 'Ouvert 24 h/24, 7 j/7, toute l’année', note: 'Écrivez-nous à toute heure. Heure du Maroc (GMT+1).', mapLabel: 'Carte d’Imlil' },
  es: { title: 'Contacto', intro: 'Lo más rápido es WhatsApp. Respondemos todos los días, normalmente en pocas horas.', where: 'Dónde estamos', hours: 'Horario', hoursText: 'Abierto 24/7, todos los días del año', note: 'Escríbanos a cualquier hora. Hora de Marruecos (GMT+1).', mapLabel: 'Mapa de Imlil' },
  de: { title: 'Kontakt', intro: 'Am schnellsten geht es per WhatsApp. Wir antworten jeden Tag, meist innerhalb weniger Stunden.', where: 'Wo wir sind', hours: 'Öffnungszeiten', hoursText: 'Rund um die Uhr geöffnet, an jedem Tag im Jahr', note: 'Schreiben Sie uns jederzeit. Marokkanische Zeit (GMT+1).', mapLabel: 'Karte von Imlil' },
  pt: { title: 'Contacto', intro: 'O mais rápido é o WhatsApp. Respondemos todos os dias, normalmente em poucas horas.', where: 'Onde estamos', hours: 'Horário', hoursText: 'Aberto 24/7, todos os dias do ano', note: 'Escreva-nos a qualquer hora. Hora de Marrocos (GMT+1).', mapLabel: 'Mapa de Imlil' },
  ar: { title: 'اتصل بنا', intro: 'أسرع طريقة هي واتساب. نجيب كل يوم، عادة في غضون ساعات قليلة.', where: 'أين نحن', hours: 'أوقات العمل', hoursText: 'مفتوح 24 ساعة طوال أيام الأسبوع وطوال السنة', note: 'راسلونا في أي وقت. بتوقيت المغرب (GMT+1).', mapLabel: 'خريطة إمليل' },
});
const ways = [
  { icon: 'whatsapp' as const, label: s.common.whatsapp, value: contact.phone, href: waLink(s.common.whatsappHello), ext: true, primary: true },
  { icon: 'phone' as const, label: s.common.phone, value: contact.phone, href: `tel:${contact.phone.replace(/\s/g, '')}` },
  { icon: 'mail' as const, label: s.common.email, value: contact.email, href: `mailto:${contact.email}` },
  ...(social.instagram ? [{ icon: 'instagram' as const, label: 'Instagram', value: social.instagram.replace(/^https?:\/\/(www\.)?/, ''), href: social.instagram, ext: true }] : []),
];
const a = contact.address;
---
<Base lang={lang} title={c.title} description={c.intro} alternates={alternates('contact')}>
  <PageHeader lang={lang} title={c.title} intro={c.intro} path={url(lang, 'contact')} />
  <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr] [&>*]:min-w-0">
    <div>
      <ul class="space-y-3">
        {ways.map((w) => (
          <li>
            <a href={w.href} target={w.ext ? '_blank' : undefined} rel={w.ext ? 'noopener' : undefined}
              class:list={['flex items-center gap-4 rounded-3xl p-5 transition', w.primary ? 'btn-whatsapp' : 'card hover:shadow-lg']}>
              <span class:list={['grid size-12 shrink-0 place-items-center rounded-2xl', w.primary ? 'bg-white/15' : 'bg-surface-2 text-accent-text']}><Icon name={w.icon} size={24} /></span>
              <span class="min-w-0"><span class="block text-sm opacity-80">{w.label}</span><span class="block break-words font-display text-lg font-semibold" dir="ltr">{w.value}</span></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div>
          <h2 class="text-h3">{c.where}</h2>
          <address class="mt-2 not-italic text-ink-2">{a.street}<br />{a.locality} {a.postalCode}<br />{a.region}<br />Morocco</address>
        </div>
        <div>
          <h2 class="text-h3">{c.hours}</h2>
          <p class="mt-2 flex items-center gap-2 font-semibold text-success"><span class="size-2.5 rounded-full bg-current" aria-hidden="true"></span>{c.hoursText}</p>
          <p class="mt-2 text-sm text-ink-3">{c.note}</p>
        </div>
      </div>
    </div>
    <div>
      <Callback lang={lang} class="mb-8" />
      <RouteMap stops={[{ name: 'Imlil', lat: contact.geo.lat, lng: contact.geo.lng, kind: 'start' }]} lang={lang} label={c.mapLabel} showList={false} />
    </div>
  </div>
</Base>
